{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SessionPal",
  "version": "0.6.0",
  "identifier": "com.sessionpal.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SessionPal",
        "width": 1100,
        "height": 720,
        "minWidth": 780,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#e7e2d9"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost https://models.dev",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421 http://localhost:1420 https://models.dev",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "Subhojit Karmakar",
    "copyright": "\u00a9 2026 Subhojit Karmakar. Released under the MIT License.",
    "shortDescription": "A local-first library for AI coding agent sessions.",
    "longDescription": "SessionPal discovers, browses, exports and backs up local sessions from Claude Code, Codex, Cursor, OpenCode and Google Antigravity. Explore project usage, estimated active time and recorded response timing. No account, cloud or telemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/essjaykay755/sessionpal/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
